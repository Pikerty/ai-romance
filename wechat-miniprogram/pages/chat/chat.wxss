.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.night-label {
  font-size: 26rpx;
  color: #666;
}

.chat-container {
  flex: 1;
  padding: 10px;
  overflow-y: auto;
}

.message {
  margin: 10px;
  padding: 10px;
  border-radius: 5px;
  max-width: 70%;
}

.user {
  background-color: #007bff;
  color: white;
  margin-left: auto;
}

.ai {
  background-color: #f0f0f0;
  margin-right: auto;
}

.loading {
  opacity: 0.75;
  font-style: italic;
}

.content {
  display: block;
}

.time {
  font-size: 12px;
  color: #666;
  display: block;
  margin-top: 5px;
}

.input-container {
  display: flex;
  padding: 10px;
  border-top: 1px solid #eee;
}

input {
  flex: 1;
  margin-right: 10px;
  padding: 8px;
  border: 1px solid #ddd;
  border-radius: 4px;
}

/* 夜间模式样式 */
.night-mode {
  background-color: #333;
  color: #fff;
}

.night-mode .header {
  border-color: #444;
}

.night-mode .ai {
  background-color: #444;
  color: #fff;
}

.night-mode .input-container {
  border-color: #444;
}

.night-mode input {
  background-color: #444;
  color: #fff;
  border-color: #555;
} 
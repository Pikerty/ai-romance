.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #f8f8f8;
}

.container.night-mode {
  background-color: #1a1a1a;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.night-mode .title {
  color: #f0f0f0;
}

.link-btn {
  background: transparent;
  color: #007aff;
  border: none;
  margin: 0;
  padding: 0 16rpx;
}

.message-list {
  flex: 1;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.message {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  max-width: 85%;
  word-break: break-word;
}

.user-message {
  background-color: #007aff;
  color: #fff;
  margin-left: auto;
}

.ai-message {
  background-color: #e5e5ea;
  color: #000;
  margin-right: auto;
}

.night-mode .ai-message {
  background-color: #333;
  color: #eee;
}

.loading {
  opacity: 0.7;
  font-style: italic;
}

.input-area {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.input-area input {
  flex: 1;
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.night-mode .input-area input {
  background: #2a2a2a;
  color: #fff;
}

.model-switcher {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.model-switcher button {
  flex: 1;
  font-size: 24rpx;
  background-color: #e5e5ea;
  color: #333;
}

.model-switcher button.active {
  background-color: #007aff;
  color: #fff;
}

.night-mode .model-switcher button {
  background-color: #333;
  color: #ccc;
}

.night-mode .model-switcher button.active {
  background-color: #007aff;
  color: #fff;
}
